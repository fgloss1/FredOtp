# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Paystack
PAYSTACK_SECRET_KEY=your_paystack_test_secret_key_here
PAYSTACK_CURRENCY=NGN
# Internal prices are stored as USD cents; this converts USD to NGN for Paystack.
# Set this to the current rate you intentionally use for your catalog.
PAYSTACK_USD_TO_NGN=
NEXT_PUBLIC_USD_TO_NGN=

# OTP supplier routing
# Keep supplier API keys server-side. Never expose them as NEXT_PUBLIC_* variables.
FIVESIM_API_TOKEN=
# Optional product override, for example FIVESIM_PRODUCT_WHATSAPP=whatsapp
# FIVESIM_PRODUCT_WHATSAPP=
SMSMAN_API_TOKEN=
SMSMAN_CURRENCY=USD
# Optional country/application ID overrides when automatic mapping is not sufficient.
# SMSMAN_COUNTRY_NG=
# SMSMAN_APPLICATION_WHATSAPP=
